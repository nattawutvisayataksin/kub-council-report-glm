# ตัวแปรทั้งหมดเป็น "ทางเลือก" — ไม่มีก็รันได้เพราะมีค่า default ในโค้ด
# ทุก endpoint ที่ใช้เป็น public endpoint ไม่ต้องมี API key

# RPC ของ KUB Chain Mainnet (Chain ID 96)
VITE_RPC_URL=https://rpc.kubchain.io

# API snapshot ของหน้า kubcouncil (ใช้เป็น cross-check + ชื่อผู้สมัคร ไม่ใช่แหล่งคะแนนหลัก)
VITE_API_FALLBACK_URL=https://kubcouncil.vercel.app/api/votes
